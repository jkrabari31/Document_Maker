rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if current logged in user is admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'jaimin3460@gmail.com' ||
        request.auth.token.email.lower() == 'admin@dastavej.com'
      );
    }

    // 1. Settings Collection (Pricing, App Configuration)
    // - Anyone (including guest users & visitors) can read the pricing
    // - Only admin can update the pricing or settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Users Collection
    // - Admin can read/write all user records
    // - Logged in users can read and update their own document
    // - New users can create their own profile upon registration
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 3. Licenses Collection (Indexed by user email)
    // - Admin has full control (read, create, update, delete)
    // - Logged in users can read their own license document
    // - System/User can update license upon verified payment
    match /licenses/{email} {
      allow read: if isAuthenticated() && (
        request.auth.token.email.lower() == email.lower() || isAdmin()
      );
      allow write: if isAdmin();
    }

    // Fallback: deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

